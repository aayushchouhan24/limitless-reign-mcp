{
  "name": "limitless-reign-mcp",
  "version": "1.0.7",
  "description": "Turn any Discord.js bot into a full MCP server with 280+ tools. Supports Claude, ChatGPT, Cursor, Windsurf, and all MCP-compatible AI clients.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "limitless-reign": "./dist/cli.js",
    "discord-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".claude",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayushchouhan24/limitless-reign-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/aayushchouhan24/limitless-reign-mcp/issues"
  },
  "homepage": "https://github.com/aayushchouhan24/limitless-reign-mcp#readme",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "discord-api",
    "discord-mcp",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "ai-tools",
    "ai-discord",
    "ai-bot",
    "claude",
    "claude-mcp",
    "chatgpt",
    "chatgpt-plugin",
    "gpt",
    "gpt-actions",
    "cursor",
    "windsurf",
    "anthropic",
    "openai",
    "llm",
    "llm-tools",
    "bot",
    "bot-framework",
    "automation",
    "discord-automation",
    "server-management",
    "moderation",
    "sdk",
    "api",
    "sse",
    "json-rpc",
    "cli"
  ],
  "author": {
    "name": "Aayush Chouhan",
    "url": "https://github.com/aayushchouhan24"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.0.0",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
